# Copiar como .env (no se sube a git) o definir en el hosting.
DATABASE_URL=sqlite:///./gradly.db
CORS_ORIGINS=http://localhost:5173
# Token para descargar las donaciones (GET /donaciones/export.csv). Vacío = desactivado.
ADMIN_TOKEN=
# Secreto para huella HMAC-SHA256 anti-duplicados (sin guardar PII). Definir fijo en producción.
ANON_HASH_SECRET=
# Límite de peticiones POST /donaciones por IP y ventana de tiempo (0 = sin límite).
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_SEC=60
# Ruta opcional al JSON de la malla (por defecto usa data/malla_sistemas.json).
MALLA_PATH=
